# ---------------------------------------------------------------------------
# Kira Haq - Environment Variables
# Copy to .env.local for local reference, or paste each NAME/VALUE pair into
# cPanel > Setup Node.js App > Environment variables on Namecheap.
# NEVER commit real secrets. Only the Firebase *client* config in
# src/lib/firebase.ts is public by design (it ships to the browser anyway).
# ---------------------------------------------------------------------------

# NODE_ENV: Set to "production" on the host so Express serves dist/ statically.
# cPanel "Application mode: Production" usually sets this for you - verify it.
NODE_ENV="production"

# PORT: Injected by cPanel / CloudLinux Passenger. Do not hard-code it.
# Only set this manually for local production testing (default fallback is 3000).
# PORT="3000"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# Optional: without it /api/ai-advisor returns a built-in fallback response.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public HTTPS origin of the deployed app, no trailing slash.
# Used for payment gateway callback/webhook URLs.
# Example: APP_URL="https://kirahaq.com"
APP_URL="MY_APP_URL"

# Payment Gateway Configurations (bKash, Nagad, Card)
# Leave empty to keep the built-in sandbox/simulated checkout behaviour.
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""

NAGAD_BASE_URL="http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs"
NAGAD_MERCHANT_ID=""
NAGAD_PUBLIC_KEY=""
NAGAD_PRIVATE_KEY=""

CARD_GATEWAY_URL="https://sandbox.sslcommerz.com/gwprocess/v4/api.php"
CARD_GATEWAY_STORE_ID=""
CARD_GATEWAY_SECRET_KEY=""
CARD_GATEWAY_MODE="sandbox"